{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "light-write module catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "modules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "modules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "path", "scope", "maturity", "provenance", "review_refs", "evaluation_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "kind": {"enum": ["field", "venue"]},
          "path": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "maturity": {"enum": ["draft", "reviewed", "evaluated"]},
          "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "review_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evaluation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
