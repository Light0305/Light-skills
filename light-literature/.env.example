# Optional. No key is required for the default sources.
# A project contact is used by default; override it if you maintain a fork.
LITSEARCH_MAILTO=

# Optional: faster PubMed rate limit.
# NCBI_API_KEY=

# Optional: OpenAlex free key (recommended).
# OPENALEX_API_KEY=

# Optional: Semantic Scholar free key.
# S2_API_KEY=


# Optional: Unpaywall contact email (defaults to LITSEARCH_MAILTO).
# UNPAYWALL_EMAIL=


# Optional cache directory.
# LITSEARCH_CACHE_DIR=.cache/litsearch

# Optional timeout in seconds.
# LITSEARCH_TIMEOUT_SECONDS=30
